# The fixtures are bytes; a map file keeps the line endings the linker wrote.
testdata/bin/*.exe binary
testdata/bin/*.dll binary
testdata/bin/*_mipsel binary
testdata/src/freestanding/build.sh eol=lf
testdata/src/psx/build.sh eol=lf
testdata/ps2/hello.elf binary
testdata/ps2/Makefile eol=lf
testdata/bin/*.map -text
testdata/expected/*.txt -text
testdata/expected/*.png binary
# the csmith programs (card #207): an expected file is one LF-ended checksum line
testdata/csmith/bin/*.exe binary
testdata/csmith/bin/*.map -text
testdata/csmith/bin/*.txt -text
# the RISC-V fixture: its ELF is bytes, and its listing keeps the line ends the disassembler wrote
testdata/riscv/*.elf binary
testdata/riscv/*.txt -text
testdata/riscv/*.out -text
# the SH-4 fixture, the same: its build script runs in WSL and keeps its line ends
testdata/sh4/*.elf binary
testdata/sh4/*.txt -text
testdata/sh4/*.out -text
testdata/sh4/build.sh eol=lf
# the Java fixtures: a class is bytes, and a listing or an output keeps the line ends it was written with
testdata/java/**/*.class binary
testdata/java/**/*.txt -text
testdata/java/**/*.out -text
