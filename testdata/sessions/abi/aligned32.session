ra-session 1
call GetStdHandle 0xfffffff5 = 0x250
call WriteFile 0x250 0x11fffe8a 0x12 0x11fffe68 0x0 = 0x1
  write 0x11fffe68 12000000
call WriteFile 0x250 0x11fffe91 0xb 0x11fffe68 0x0 = 0x1
  write 0x11fffe68 0b000000
call WriteFile 0x250 0x11fffe8b 0x11 0x11fffe68 0x0 = 0x1
  write 0x11fffe68 11000000
call ExitProcess 0x0 ! exit 0
