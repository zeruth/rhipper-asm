# arm32 vectors of the arm_data group (ARM code): the state after each case of
# cases/arm_data.cases under qemu-arm-static (-cpu max) over 3 states a case, written by
# write_arm32_vectors in crates/ra-asm-lift/tests/vectors/arm32.rs and replayed by its arm32 test.
# case <kind> <bytes> <assembly> <- <template>; in: the registers the case sets (the rest are
# zero), the flags as NZCV bits, the window of data bytes; out: where the case stopped and
# what it changed.
case Alu 02008100 addeq r0, r1, r2 <- add{cond} {Rd}, {Rn}, {Rm}
in nzcv=1100 r0=0xfffffffc r1=0xd3bf789a r2=0x8
out pc=0x30002004 sig=trap r0=0xd3bf78a2
