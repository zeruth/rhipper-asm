# arm32 vectors of the bitfield group (Thumb-2 code): the state after each case of
# cases/bitfield.cases under qemu-arm-static (-cpu max) over 3 states a case, written by
# write_arm32_vectors in crates/ra-asm-lift/tests/vectors/arm32.rs and replayed by its arm32 test.
# case <kind> <bytes> <assembly> <- <template>; in: the registers the case sets (the rest are
# zero), the flags as NZCV bits, the window of data bytes; out: where the case stopped and
# what it changed.
case Field 41f31f00 sbfx r0, r1, #0, #32 <- sbfx {Rd}, {Rn}, #{lsb}, #{width}
in nzcv=0100 r0=0x7fff r1=0x7ffffff7
out pc=0x30002004 sig=trap r0=0x7ffffff7
case Field 41f31f00 sbfx r0, r1, #0, #32 <- sbfx {Rd}, {Rn}, #{lsb}, #{width}
in nzcv=1001 r0=0x1ffff r1=0x8000
out pc=0x30002004 sig=trap r0=0x8000
case Field 41f31f00 sbfx r0, r1, #0, #32 <- sbfx {Rd}, {Rn}, #{lsb}, #{width}
in nzcv=1111 r0=0x80000006 r1=0xa383967a
out pc=0x30002004 sig=trap r0=0xa383967a
case Field 48f30715 sbfx r5, r8, #4, #8 <- sbfx {Rd}, {Rn}, #{lsb}, #{width}
in nzcv=0001 r5=0xed367a16 r8=0x100000
out pc=0x30002004 sig=trap r5=0x0
case Field 48f30715 sbfx r5, r8, #4, #8 <- sbfx {Rd}, {Rn}, #{lsb}, #{width}
in nzcv=0001 r5=0x80000000 r8=0x20000000
