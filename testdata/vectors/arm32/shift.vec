# arm32 vectors of the shift group (Thumb-2 code): the state after each case of
# cases/shift.cases under qemu-arm-static (-cpu max) over 3 states a case, written by
# write_arm32_vectors in crates/ra-asm-lift/tests/vectors/arm32.rs and replayed by its arm32 test.
# case <kind> <bytes> <assembly> <- <template>; in: the registers the case sets (the rest are
# zero), the flags as NZCV bits, the window of data bytes; out: where the case stopped and
# what it changed.
case Alu 5000 lsls r0, r2, #1 <- lsls {Ld}, {Lm}, #{shift5}
in nzcv=0111 r0=0x7ffffff1 r2=0x3ffffff
out pc=0x30002002 sig=trap r0=0x7fffffe nzcv=0001
case Alu 5000 lsls r0, r2, #1 <- lsls {Ld}, {Lm}, #{shift5}
in nzcv=0001 r0=0x80000005 r2=0xd21c27
out pc=0x30002002 sig=trap r0=0x1a4384e
case Alu 5000 lsls r0, r2, #1 <- lsls {Ld}, {Lm}, #{shift5}
in nzcv=1111 r0=0x1ff r2=0xdbc85797
out pc=0x30002002 sig=trap r0=0xb790af2e nzcv=1011
case Alu fb01 lsls r3, r7, #7 <- lsls {Ld}, {Lm}, #{shift5}
in nzcv=0000 r3=0xfffffff2 r7=0x7ffffff5
out pc=0x30002002 sig=trap r3=0xfffffa80 nzcv=1010
case Alu fb01 lsls r3, r7, #7 <- lsls {Ld}, {Lm}, #{shift5}
in nzcv=1011 r3=0xd r7=0x80000007
out pc=0x30002002 sig=trap r3=0x380 nzcv=0001
case Alu fb01 lsls r3, r7, #7 <- lsls {Ld}, {Lm}, #{shift5}
in nzcv=0100 r3=0x40000000 r7=0x6e193378
out pc=0x30002002 sig=trap r3=0xc99bc00 nzcv=0010
