in nzcv=1111
out pc=0x30002000 sig=trap
case Bkpt 55be bkpt #0x55 <- bkpt #{bkpt}
in nzcv=1000
out pc=0x30002000 sig=trap
case Bkpt 55be bkpt #0x55 <- bkpt #{bkpt}
in nzcv=0111
out pc=0x30002000 sig=trap
case Bkpt ffbe bkpt #0xff <- bkpt #{bkpt}
in nzcv=0001
out pc=0x30002000 sig=trap
case Bkpt ffbe bkpt #0xff <- bkpt #{bkpt}
in nzcv=1111
out pc=0x30002000 sig=trap
case Bkpt ffbe bkpt #0xff <- bkpt #{bkpt}
in nzcv=0000
out pc=0x30002000 sig=trap
case Bkpt 01be bkpt #1 <- bkpt #{bkpt}
in nzcv=0011
out pc=0x30002000 sig=trap
case Bkpt 01be bkpt #1 <- bkpt #{bkpt}
in nzcv=0100
out pc=0x30002000 sig=trap
case Bkpt 01be bkpt #1 <- bkpt #{bkpt}
in nzcv=0010
out pc=0x30002000 sig=trap
