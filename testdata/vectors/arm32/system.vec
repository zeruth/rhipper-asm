# arm32 vectors of the system group (Thumb-2 code): the state after each case of
# cases/system.cases under qemu-arm-static (-cpu max) over 3 states a case, written by
# write_arm32_vectors in crates/ra-asm-lift/tests/vectors/arm32.rs and replayed by its arm32 test.
# case <kind> <bytes> <assembly> <- <template>; in: the registers the case sets (the rest are
# zero), the flags as NZCV bits, the window of data bytes; out: where the case stopped and
# what it changed.
case Nop 00bf nop <- nop
in nzcv=1000
out pc=0x30002002 sig=trap
case Nop 00bf nop <- nop
in nzcv=1100
out pc=0x30002002 sig=trap
case Nop 00bf nop <- nop
in nzcv=0011
out pc=0x30002002 sig=trap
case Nop aff30080 nop.w <- nop.w
in nzcv=0010
out pc=0x30002004 sig=trap
case Nop aff30080 nop.w <- nop.w
in nzcv=1100
out pc=0x30002004 sig=trap
case Nop aff30080 nop.w <- nop.w
in nzcv=1001
out pc=0x30002004 sig=trap
case Bkpt 00be bkpt #0 <- bkpt #{bkpt}
in nzcv=0011
out pc=0x30002000 sig=trap
case Bkpt 00be bkpt #0 <- bkpt #{bkpt}
in nzcv=1000
out pc=0x30002000 sig=trap
case Bkpt 00be bkpt #0 <- bkpt #{bkpt}
in nzcv=1011
out pc=0x30002000 sig=trap
