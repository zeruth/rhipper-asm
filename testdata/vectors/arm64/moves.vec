in nzcv=1111 x0=0x7ffffffff
out pc=0x30002004 sig=trap x0=0x0
case MOVZ d2bfffe5 movz x5, #0xffff, lsl #16 <- movz {Xd}, #{imm16}, lsl #{hw64}
in nzcv=1001 x5=0x1000000
out pc=0x30002004 sig=trap x5=0xffff0000
