# arm64 vectors of the muldiv group: the state after each case of cases/muldiv.cases under
# qemu-aarch64-static (-cpu max,pauth=off) over 3 states a case, written by
# write_arm64_vectors in crates/ra-asm-lift/tests/vectors.rs and replayed by its arm64 test.
# case <opcode> <encoding> <assembly> <- <template>; in: the registers the case sets (the
# rest are zero), the flags as NZCV bits, the window of data bytes; out: where the case
# stopped and what it changed.
case MADD 9b020c20 madd x0, x1, x2, x3 <- madd {Xd}, {Xn}, {Xm}, {Xa}
in nzcv=1100 x0=0x3ffffffffff x1=0xa0e1539acc6ebf72 x2=0xfffffffffffffffc x3=0x3fffffffffffff
out pc=0x30002004 sig=trap x0=0x7cbab194ce450237
